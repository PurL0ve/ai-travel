# ================================
# AI Travel Platform 环境变量配置示例
# ================================
# 复制此文件为 .env 并填入实际值
# 生产环境必须设置所有环境变量，不能使用默认值

# -------------------------------
# 数据库配置
# -------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_database_password_here

# -------------------------------
# JWT配置
# -------------------------------
# 生产环境必须使用强随机密钥（至少256位）
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_256_bits

# -------------------------------
# Nacos配置
# -------------------------------
NACOS_SERVER_ADDR=localhost:8848

# -------------------------------
# AI服务配置
# -------------------------------
# DashScope API密钥（阿里云百炼平台）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Qdrant向量数据库配置
QDRANT_HOST=localhost
QDRANT_PORT=6333

# -------------------------------
# 其他配置
# -------------------------------
# 服务器端口（可选，默认已在application.yml中配置）
# SERVER_PORT=8080
